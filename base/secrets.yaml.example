# ============================================================================
# secrets.yaml.example — copy to /config/secrets.yaml and fill in.
# ============================================================================
# NEVER commit the real secrets.yaml to git. This kit's .gitignore excludes
# it, and scripts/check-secrets.py will catch common token formats if you
# wire it as a pre-commit hook (see docs/secrets-and-git-safety.md).
#
# Each component's README has a "secrets.yaml keys needed" section — most
# components need none at all. Only fill in the keys for components you
# actually install.
# ============================================================================

# ----------------------------------------------------------------------------
# HOME ASSISTANT keys — these belong in THIS file (/config/secrets.yaml)
# ----------------------------------------------------------------------------

# Component 12 (guardrails) — only if you follow its optional Telegram
# notification setup (see components/12-guardrails/README.md for how to
# get both values from BotFather):
telegram_api_key: "110201543:replace-with-your-bot-token"
telegram_chat_id: 123456789

# ----------------------------------------------------------------------------
# ESPHome has its OWN secrets.yaml (in the ESPHome add-on's config dir,
# NOT this file)
# ----------------------------------------------------------------------------
# The keys below go in ESPHome's separate secrets.yaml — usually
# /config/esphome/secrets.yaml. They're listed here (commented out) purely
# for reference; putting them in Home Assistant's secrets.yaml does nothing
# for ESPHome builds. Component 08 ships a fuller ESPHome secrets example
# at components/08-esphome-ble-presence/esphome/secrets.yaml.example.
#
# Generate an API encryption key with:  openssl rand -base64 32
#
# wifi_ssid: "YourNetworkName"                                # components 08, 09, 10
# wifi_password: "your-wifi-password"                         # components 08, 09, 10
# presence_node_api_key: "GENERATE-ME-32-BYTES-BASE64="       # component 08
# presence_node_ota_password: "pick-a-long-random-password"   # component 08
# action_button_api_key: "GENERATE-ME-32-BYTES-BASE64="       # component 09
# action_button_ota_password: "pick-a-long-random-password"   # component 09
# fallback_ap_password: "pick-a-long-random-password"         # component 10
# voice_satellite_1_api_key: "GENERATE-ME-32-BYTES-BASE64="   # component 10 (optional)
