# ============================================================================
# secrets.yaml.example — copy to /config/secrets.yaml and fill in.
# ============================================================================
# NEVER commit the real secrets.yaml to git. This kit's .gitignore excludes
# it, and scripts/check-secrets.py will catch common token formats if you
# wire it as a pre-commit hook (see docs/secrets-and-git-safety.md).
#
# Each component's README lists which of these keys it actually needs —
# you only need to fill in the ones for components you install.
# ============================================================================

# --- Wi-Fi (used by ESPHome device configs) ---------------------------------
wifi_ssid: "YourNetworkName"
wifi_password: "your-wifi-password"

# --- ESPHome device credentials (generate per-device) -----------------------
# Generate an API encryption key with:  openssl rand -base64 32
esphome_api_key: "generate-me"
esphome_ota_password: "generate-me"

# --- Notifications ----------------------------------------------------------
# If you use the Telegram integration for phone alerts:
telegram_bot_token: "123456789:replace-with-your-bot-token"
telegram_chat_id: "123456789"
