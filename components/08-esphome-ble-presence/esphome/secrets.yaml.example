# Copy to secrets.yaml IN THE SAME FOLDER AS THESE NODE CONFIGS.
# (ESPHome has its own secrets.yaml — this is NOT Home Assistant's
# /config/secrets.yaml, though the ESPHome add-on shares HA's if you build
# there.)

wifi_ssid: "YourNetworkName"
wifi_password: "your-wifi-password"

# 32-byte base64 key for the encrypted ESPHome↔HA API link.
# Generate one:  openssl rand -base64 32
# (or let `esphome wizard` generate it for you)
presence_node_api_key: "GENERATE-ME-32-BYTES-BASE64="

# Password for over-the-air updates + the rescue hotspot.
presence_node_ota_password: "pick-a-long-random-password"
